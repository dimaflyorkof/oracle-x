[Unit]
Description=ORACLE X ALFRED Initial-Release Vintage Collector
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/oracle-x
EnvironmentFile=/root/oracle-x/.env
ExecStart=/root/oracle-x/venv/bin/python -u -m collectors.global_data.alfred_vintage_collector
Nice=10
MemoryMax=256M
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
