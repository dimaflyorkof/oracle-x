[Unit]
Description=ORACLE X Spot and Futures Kline Orderflow Collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/oracle-x
ExecStart=/root/oracle-x/venv/bin/python -u -m collectors.market.orderflow_kline_collector
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
